<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RADIO WORLD – Offline Rádióközpont"
        android:textColor="#00E676"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeadsetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:text="Antenna (3,5 mm jack) ellenőrzése..."
        android:textColor="#FFD54F"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnLaunchXiaomiFm"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00C853"
        android:text="GYÁRI FM RÁDIÓ INDÍTÁSA (COM.MIUI.FM)"
        android:textColor="#000000"
        android:textStyle="bold" />

    <!-- SDR Hardver státusz panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KÜLSŐ RTL-SDR USB VEVŐ ÁLLAPOT"
            android:textColor="#40C4FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSdrStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nincs RTL-SDR csatlakoztatva az OTG portra."
            android:textColor="#BDBDBD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScanUsb"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2979FF"
            android:text="USB OTG ESZKÖZ KERESÉSE"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Új saját kedvenc hozzáadása -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etFreqInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#262626"
            android:hint="Pl. 90,9 MHz – Helyi adó"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAddFavorite"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFAB00"
            android:text="MENTÉS"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Frekvenciatáblázat (Rövid érintés: másolás | Hosszú: törlés):"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listStations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="#333333"
        android:dividerHeight="1dp" />

</LinearLayout>
